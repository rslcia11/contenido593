---
/** Lista numerada ("Lo más leído") con portadas visuales. */
import { articleHref, articleKicker, type Article } from '@/lib/content';
import Cover from './Cover.astro';

interface Props {
  title: string;
  articles: Article[];
}

const { title, articles } = Astro.props;
const items = await Promise.all(articles.map(async (a) => ({ article: a, kicker: await articleKicker(a) })));
---

{items.length > 0 && (
  <section class="top-ranking" aria-label={title}>
    <h2>{title}</h2>
    <ol>
      {items.map(({ article, kicker }) => (
        <li class="ranking-item">
          <a class="ranking-link pressable" href={articleHref(article)}>
            <div class="ranking-thumb">
              <Cover article={article} />
            </div>
            <div class="ranking-body">
              <span class="ranking-kicker">{kicker}</span>
              <h4>{article.data.title}</h4>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .top-ranking {
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: 18px;
    box-shadow: var(--shadow-pop);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: var(--weight-heavy);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: var(--border);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: rank;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ranking-item {
    counter-increment: rank;
    position: relative;
  }

  .ranking-link {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
    padding: 6px;
    border-radius: var(--radius-md);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .ranking-link:hover {
    background: var(--color-bg-deep);
    transform: translateX(3px);
  }

  .ranking-thumb {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    width: 84px;
    flex-shrink: 0;
  }

  .ranking-thumb::before {
    content: counter(rank);
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 2;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-family: var(--font-display);
    font-weight: var(--weight-heavy);
    font-size: 0.75rem;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-xs);
    display: grid;
    place-items: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }

  .ranking-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ranking-kicker {
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  h4 {
    font-size: 0.875rem;
    font-weight: var(--weight-heavy);
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .ranking-link:hover h4 {
    color: var(--color-accent);
  }
</style>

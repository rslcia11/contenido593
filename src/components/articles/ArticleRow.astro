---
/** Artículo en lista: portada a la izquierda, título, entradilla y fecha. */
import { articleHref, articleKicker, type Article } from '@/lib/content';
import Cover from './Cover.astro';
import ArticleMeta from './ArticleMeta.astro';

interface Props {
  article: Article;
  compact?: boolean;
}

const { article, compact = false } = Astro.props;
const kicker = await articleKicker(article);
---

<a
  class:list={['row', 'pressable', { compact }]}
  href={articleHref(article)}
  data-tag={article.data.tag}
  data-article={article.id}
>
  <div class="row-cover">
    <Cover article={article} />
  </div>
  <div class="row-content">
    <span class="tag">{kicker}</span>
    <h3>{article.data.title}</h3>
    <p>{article.data.description}</p>
    <ArticleMeta article={article} />
  </div>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 22px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: var(--border);
    align-items: center;
    margin-bottom: 14px;
    text-decoration: none;
    color: var(--color-text);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .row:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 24px -4px rgba(0, 240, 255, 0.25);
  }

  .row-cover {
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .row-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tag {
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: var(--weight-heavy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    background: rgba(0, 240, 255, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(0, 240, 255, 0.25);
  }

  h3 {
    font-size: 1.1875rem;
    font-weight: var(--weight-heavy);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .row:hover h3 {
    color: var(--color-accent);
  }

  p {
    color: var(--color-text-2);
    font-size: 0.875rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .compact {
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    padding: 12px;
  }

  .compact h3 {
    font-size: var(--text-base);
  }

  .compact p {
    display: none;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .compact {
      grid-template-columns: 1fr;
    }

    p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>

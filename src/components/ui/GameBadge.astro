---
interface Props {
  game: string;
  size?: number;
  class?: string;
}

const { game, size = 72, class: className = '' } = Astro.props;
---

<div class={`game-badge game-badge--${game} ${className}`}>
  {/* ---------- MINECRAFT: Bloque de césped 3D isométrico grande y detallado ---------- */}
  {game === 'minecraft' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <filter id="mc-shadow-lg" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#000" flood-opacity="0.5" />
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#5cb82e" flood-opacity="0.4" />
        </filter>
      </defs>
      <g filter="url(#mc-shadow-lg)">
        {/* Cara Superior (Césped vibrante) */}
        <polygon points="24,4 44,15 24,26 4,15" fill="#5cb82e" />
        {/* Píxeles de textura superior */}
        <polygon points="24,4 34,9.5 24,15 14,9.5" fill="#7ce643" opacity="0.85" />
        <polygon points="20,11.5 24,13.7 20,16 16,13.7" fill="#46991f" />
        <polygon points="28,11 32,13.2 28,15.5 24,13.2" fill="#8eff52" />
        <polygon points="24,17.5 28,19.7 24,22 20,19.7" fill="#7ce643" />
        <polygon points="34,15.5 39,18.3 34,21 29,18.3" fill="#46991f" />
        <polygon points="14,15.5 19,18.3 14,21 9,18.3" fill="#7ce643" />

        {/* Cara Izquierda (Tierra + flecos de pasto) */}
        <polygon points="4,15 24,26 24,44 4,33" fill="#704b2e" />
        {/* Manchas de tierra izquierda */}
        <polygon points="7,23 12,26 12,30 7,27" fill="#4c311c" />
        <polygon points="15,29 20,32 20,36 15,33" fill="#8d623e" />
        <polygon points="8,33 13,36 13,40 8,37" fill="#4c311c" />
        {/* Flecos de pasto colgando izquierda */}
        <polygon points="4,15 24,26 24,30 21,28 21,32 16,29 16,32 11,29 11,32 4,19" fill="#4a9b23" />

        {/* Cara Derecha (Tierra en sombra + flecos) */}
        <polygon points="24,26 44,15 44,33 24,44" fill="#4c311c" />
        {/* Manchas de tierra derecha */}
        <polygon points="29,30 35,27 35,31 29,34" fill="#362111" />
        <polygon points="35,34 40,31 40,35 35,38" fill="#704b2e" />
        {/* Flecos de pasto colgando derecha */}
        <polygon points="44,15 24,26 24,30 27,28 27,32 32,29 32,32 37,29 37,32 44,19" fill="#3b7d1c" />
      </g>
    </svg>
  )}

  {/* ---------- ROBLOX: Cubo Inclinado 15° con Bisel Plateado y Halo Neón ---------- */}
  {game === 'roblox' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="rbx-grad-lg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="45%" stop-color="#E2E8F0" />
          <stop offset="100%" stop-color="#94A3B8" />
        </linearGradient>
        <filter id="rbx-halo-lg" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#00A2FF" flood-opacity="0.6" />
          <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#FFFFFF" flood-opacity="0.4" />
        </filter>
      </defs>
      <g filter="url(#rbx-halo-lg)">
        {/* Contorno exterior inclinado 15° */}
        <path
          d="M13 5 L43 12 L35 43 L5 36 Z"
          fill="url(#rbx-grad-lg)"
          stroke="#0F172A"
          stroke-width="2"
          stroke-linejoin="round"
        />
        {/* Bisel iluminado 3D */}
        <path d="M15 8 L40 14 L33 40 L8 34 Z" fill="#FFFFFF" opacity="0.4" />
        {/* Hueco central inclinado 15° */}
        <path
          d="M20.5 19.5 L29.5 22 L26.5 31 L17.5 28.5 Z"
          fill="#070A10"
          stroke="#1E293B"
          stroke-width="1.2"
        />
      </g>
    </svg>
  )}

  {/* ---------- GTA VI: Roman "VI" Sunset Vice City con Palmeras ---------- */}
  {game === 'gta6' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="gta-sunset-lg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FF007F" />
          <stop offset="45%" stop-color="#FF1493" />
          <stop offset="100%" stop-color="#00F0FF" />
        </linearGradient>
        <filter id="gta-glow-xl" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="0" stdDeviation="5" flood-color="#FF007F" flood-opacity="0.75" />
          <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#00F0FF" flood-opacity="0.6" />
        </filter>
      </defs>
      <g filter="url(#gta-glow-xl)">
        {/* Palmera izquierda */}
        <path d="M6 28 C8 19 13 14 15 11 C12 15 11 19 10 28 Z" fill="#00F0FF" opacity="0.4" />
        <path d="M6 20 C11 18 14 15 15 11 C11 18 9 22 7 24 Z" fill="#00F0FF" opacity="0.35" />
        {/* Palmera derecha */}
        <path d="M42 28 C40 19 35 14 33 11 C36 15 37 19 38 28 Z" fill="#FF007F" opacity="0.4" />
        <path d="M42 20 C37 18 34 15 33 11 C37 18 39 22 41 24 Z" fill="#FF007F" opacity="0.35" />

        {/* Letra 'V' */}
        <path
          d="M7 9 L15 9 L20.5 32 L22 32 L27.5 9 L35.5 9 L25.5 39 L17 39 Z"
          fill="url(#gta-sunset-lg)"
          stroke="#000000"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        {/* Letra 'I' con serifs de lujo */}
        <path
          d="M31.5 9 L44.5 9 L44.5 14 L40.5 14 L40.5 34 L44.5 34 L44.5 39 L31.5 39 L31.5 34 L35.5 34 L35.5 14 L31.5 14 Z"
          fill="url(#gta-sunset-lg)"
          stroke="#000000"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )}

  {/* ---------- FREE FIRE: Emblema Bélico "FF" con Daga Táctica y Fuego ---------- */}
  {game === 'freefire' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ff-shield-grad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#FF6B00" />
          <stop offset="50%" stop-color="#D90429" />
          <stop offset="100%" stop-color="#4A0000" />
        </linearGradient>
        <linearGradient id="ff-gold-blade" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF275" />
          <stop offset="50%" stop-color="#FFB703" />
          <stop offset="100%" stop-color="#FB8500" />
        </linearGradient>
        <filter id="ff-inferno-xl" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="5" flood-color="#FF3E00" flood-opacity="0.85" />
          <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#FFB703" flood-opacity="0.7" />
        </filter>
      </defs>
      <g filter="url(#ff-inferno-xl)">
        {/* Escudo bélico de fondo */}
        <path
          d="M24 3 L40 10 C40 24 33 38 24 45 C15 38 8 24 8 10 Z"
          fill="url(#ff-shield-grad)"
          stroke="#FFB703"
          stroke-width="1.8"
        />

        {/* Llamas dinámicas superiores */}
        <path
          d="M24 3 C26 9 30 12 32 16 C29 14 26 15 24 13 C22 15 19 14 16 16 C18 12 22 9 24 3 Z"
          fill="#FFE600"
        />

        {/* Daga de combate central estilizada */}
        <path d="M24 8 L27 24 L24 38 L21 24 Z" fill="#FFFFFF" stroke="#000" stroke-width="1" />

        {/* Monograma de combate "FF" cortado a 45° */}
        {/* Primera F (izquierda) */}
        <path
          d="M13 16 L22 16 L21 20 L16 20 L15.5 23 L19.5 23 L19 26 L14.5 26 L13 34 L10 34 Z"
          fill="url(#ff-gold-blade)"
          stroke="#000"
          stroke-width="0.8"
        />
        {/* Segunda F (derecha con filo de cuchillo) */}
        <path
          d="M25 16 L34 16 L33 20 L28 20 L27.5 23 L31.5 23 L31 26 L26.5 26 L25 34 L22 34 Z"
          fill="url(#ff-gold-blade)"
          stroke="#000"
          stroke-width="0.8"
        />
      </g>
    </svg>
  )}

  {/* ---------- FORTNITE: Escudo Angular con la Legendaria "F" del Battle Royale ---------- */}
  {game === 'fortnite' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="fn-grad-xl" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00F5FF" />
          <stop offset="50%" stop-color="#00A2FF" />
          <stop offset="100%" stop-color="#9333EA" />
        </linearGradient>
        <filter id="fn-glow-xl" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="5" flood-color="#00F5FF" flood-opacity="0.7" />
          <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#9333EA" flood-opacity="0.5" />
        </filter>
      </defs>
      <g filter="url(#fn-glow-xl)">
        {/* Escudo facetado de victoria */}
        <polygon
          points="24,4 42,10 37,38 24,45 11,38 6,10"
          fill="#080E1A"
          stroke="url(#fn-grad-xl)"
          stroke-width="2"
        />
        {/* Letra 'F' enérgica e inclinada */}
        <path
          d="M16 11 L35 11 L33 17 L23 17 L22 22 L31 22 L29 28 L21 28 L19 38 L13 38 Z"
          fill="url(#fn-grad-xl)"
          stroke="#000000"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )}
</div>

<style>
  .game-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.3s ease;
  }

  .game:hover .game-badge {
    transform: scale(1.16) translateY(-4px);
  }
</style>

---
interface Props {
  game: string;
  size?: number;
  class?: string;
}

const { game, size = 36, class: className = '' } = Astro.props;
---

<div class={`game-badge game-badge--${game} ${className}`} style={`--size: ${size}px;`}>
  {game === 'minecraft' && (
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" aria-hidden="true">
      {/* 3D Isometric Grass Block */}
      <defs>
        <filter id="mc-shadow" x="-10%" y="-10%" width="120%" height="120%">
          <feDropShadow dx="0" dy="2" stdDeviation="1.5" flood-color="#000" flood-opacity="0.4" />
        </filter>
      </defs>
      <g filter="url(#mc-shadow)">
        {/* Top Face (Lush Grass) */}
        <polygon points="20,4 35,12.5 20,21 5,12.5" fill="#5cb82e" />
        {/* Top Face Pixel Grid Highlights */}
        <polygon points="20,4 27.5,8.25 20,12.5 12.5,8.25" fill="#71ce3b" opacity="0.6" />
        <polygon points="16,10 20,12.5 16,14.7 12,12.5" fill="#4d9b23" />
        <polygon points="24,9.5 28,11.8 24,14 20,11.8" fill="#7ed945" />
        {/* Left Face (Dirt + Grass Drop) */}
        <polygon points="5,12.5 20,21 20,36 5,27.5" fill="#735135" />
        {/* Dirt Texture Left */}
        <polygon points="8,19 12,21.5 12,25 8,22.5" fill="#543b25" />
        <polygon points="14,24 17,25.8 17,28.5 14,27" fill="#8c6443" />
        {/* Grass Fringe Left */}
        <polygon points="5,12.5 20,21 20,24 17,22 17,25 13,22.5 13,24 9,21.5 9,23.5 5,15" fill="#4d9b23" />
        {/* Right Face (Dirt in Shadow + Grass Drop) */}
        <polygon points="20,21 35,12.5 35,27.5 20,36" fill="#543b25" />
        {/* Dirt Texture Right */}
        <polygon points="24,24 28,21.5 28,24 24,26.5" fill="#3b291a" />
        <polygon points="27,27 31,24.5 31,27.5 27,29.8" fill="#735135" />
        {/* Grass Fringe Right */}
        <polygon points="35,12.5 20,21 20,24 23,22 23,25 27,22.5 27,24 31,21.5 31,23 35,14" fill="#3c7c1b" />
      </g>
    </svg>
  )}

  {game === 'roblox' && (
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="rbx-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="100%" stop-color="#C5D3E8" />
        </linearGradient>
        <filter id="rbx-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#00A2FF" flood-opacity="0.35" />
        </filter>
      </defs>
      <g filter="url(#rbx-glow)">
        {/* Tilted Roblox Square (approx 15 deg tilt) */}
        <path
          d="M12.5 6.5 L33.5 12 L27.5 33.5 L6.5 28 Z"
          fill="url(#rbx-grad)"
          stroke="#0F172A"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        {/* Hollow Centered Inner Square */}
        <path d="M17.5 16.5 L24.5 18.5 L22.5 25.5 L15.5 23.5 Z" fill="#0B0E17" />
      </g>
    </svg>
  )}

  {game === 'gta6' && (
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="gta-sunset" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FF1493" />
          <stop offset="50%" stop-color="#FF007F" />
          <stop offset="100%" stop-color="#00F0FF" />
        </linearGradient>
        <filter id="gta-neon" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#FF007F" flood-opacity="0.6" />
        </filter>
      </defs>
      <g filter="url(#gta-neon)">
        {/* Grand Theft Auto VI Roman Numerals with Vice City Neon Gradient */}
        {/* Letter 'V' */}
        <path
          d="M6 9 L12.5 9 L16.5 27 L18 27 L22 9 L28.5 9 L20.5 31 L14 31 Z"
          fill="url(#gta-sunset)"
          stroke="#000"
          stroke-width="1"
        />
        {/* Letter 'I' */}
        <path d="M27.5 9 L34 9 L34 31 L27.5 31 Z" fill="url(#gta-sunset)" stroke="#000" stroke-width="1" />
        {/* Horizontal Serif Accents */}
        <rect x="25" y="9" width="11.5" height="3" fill="url(#gta-sunset)" />
        <rect x="25" y="28" width="11.5" height="3" fill="url(#gta-sunset)" />
      </g>
    </svg>
  )}

  {game === 'freefire' && (
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ff-flame" x1="0%" y1="100%" x2="50%" y2="0%">
          <stop offset="0%" stop-color="#FF2A00" />
          <stop offset="50%" stop-color="#FF6B00" />
          <stop offset="100%" stop-color="#FFD600" />
        </linearGradient>
        <filter id="ff-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#FF4500" flood-opacity="0.6" />
        </filter>
      </defs>
      <g filter="url(#ff-glow)">
        {/* Free Fire Winged Flame Blade */}
        <path
          d="M20 4 C21 11 27 15 27 21 C27 29 20 36 20 36 C20 36 13 29 13 21 C13 16 16 12 18 8 Z"
          fill="url(#ff-flame)"
        />
        <path
          d="M20 14 C21 18 24 20 24 24 C24 28 20 32 20 32 C20 32 16 28 16 24 C16 20 18 17 20 14 Z"
          fill="#FFF275"
        />
        {/* Knife / Wing Flashes */}
        <path d="M8 22 C11 20 14 22 14 26 C12 28 9 26 8 22 Z" fill="#FF4500" />
        <path d="M32 22 C29 20 26 22 26 26 C28 28 31 26 32 22 Z" fill="#FF4500" />
      </g>
    </svg>
  )}

  {game === 'fortnite' && (
    <svg viewBox="0 0 40 40" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="fn-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00F0FF" />
          <stop offset="100%" stop-color="#7B2CBF" />
        </linearGradient>
        <filter id="fn-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#00F0FF" flood-opacity="0.5" />
        </filter>
      </defs>
      <g filter="url(#fn-glow)">
        {/* Fortnite Stylized Bold F */}
        <path
          d="M10 7 L30 7 L28 13 L18 13 L17 18 L26 18 L24 24 L16 24 L14 34 L8 34 Z"
          fill="url(#fn-grad)"
          stroke="#000"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )}
</div>

<style>
  .game-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .game:hover .game-badge {
    transform: scale(1.12) translateY(-2px);
  }
</style>

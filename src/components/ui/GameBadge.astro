---
interface Props {
  game: string;
  size?: number;
  class?: string;
}

const { game, size = 56, class: className = '' } = Astro.props;
---

<div class={`game-badge game-badge--${game} ${className}`} style={`--size: ${size}px;`}>
  {/* ---------- MINECRAFT: Bloque de césped 3D isométrico auténtico ---------- */}
  {game === 'minecraft' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <filter id="mc-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#5cb82e" flood-opacity="0.35" />
        </filter>
      </defs>
      <g filter="url(#mc-glow)">
        {/* Cara Superior (Césped vibrante) */}
        <polygon points="24,5 43,15.5 24,26 5,15.5" fill="#5cb82e" />
        {/* Píxeles de textura superior */}
        <polygon points="24,5 33.5,10.2 24,15.5 14.5,10.2" fill="#78d443" opacity="0.8" />
        <polygon points="20,12 24,14.2 20,16.5 16,14.2" fill="#4a9b23" />
        <polygon points="28,11.5 32,13.7 28,16 24,13.7" fill="#8cee4f" />
        <polygon points="24,18 28,20.2 24,22.5 20,20.2" fill="#78d443" />
        <polygon points="33,16 38,18.8 33,21.5 28,18.8" fill="#4a9b23" opacity="0.9" />
        <polygon points="15,16 20,18.8 15,21.5 10,18.8" fill="#78d443" opacity="0.9" />

        {/* Cara Izquierda (Tierra + flecos de pasto) */}
        <polygon points="5,15.5 24,26 24,43 5,32.5" fill="#6d4c31" />
        {/* Manchas de tierra izquierda */}
        <polygon points="8,24 13,27 13,31 8,28" fill="#4e3520" />
        <polygon points="16,30 20,32.5 20,36 16,33.5" fill="#88603f" />
        <polygon points="9,33 13,35.5 13,39 9,36.5" fill="#4e3520" />
        {/* Flecos de césped cayendo a la izquierda */}
        <polygon
          points="5,15.5 24,26 24,29.5 21,27.5 21,31 16,28 16,30.5 11,27.5 11,30 5,18.5"
          fill="#4a9b23"
        />

        {/* Cara Derecha (Tierra en sombra + flecos) */}
        <polygon points="24,26 43,15.5 43,32.5 24,43" fill="#4e3520" />
        {/* Manchas de tierra derecha */}
        <polygon points="29,30 34,27 34,31 29,34" fill="#382516" />
        <polygon points="34,34 39,31 39,35 34,38" fill="#6d4c31" />
        {/* Flecos de césped cayendo a la derecha */}
        <polygon
          points="43,15.5 24,26 24,29.5 27,27.5 27,31 32,28 32,30.5 37,27.5 37,30 43,18.5"
          fill="#3b7d1c"
        />
      </g>
    </svg>
  )}

  {/* ---------- ROBLOX: Tilted Square Metálico con Resplandor Neón ---------- */}
  {game === 'roblox' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="rbx-face" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="40%" stop-color="#E2E8F0" />
          <stop offset="100%" stop-color="#94A3B8" />
        </linearGradient>
        <filter id="rbx-halo" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#00A2FF" flood-opacity="0.5" />
        </filter>
      </defs>
      <g filter="url(#rbx-halo)">
        {/* Marco base inclinado 15° */}
        <path
          d="M14 6 L42 13 L34 42 L6 35 Z"
          fill="url(#rbx-face)"
          stroke="#0F172A"
          stroke-width="2"
          stroke-linejoin="round"
        />
        {/* Borde biselado interior */}
        <path d="M16 9 L39 15 L32 39 L9 33 Z" fill="#FFFFFF" opacity="0.3" />
        {/* Hueco cuadrado central inclinado */}
        <path d="M21 20 L30 22.5 L27 31 L18 28.5 Z" fill="#080B11" />
      </g>
    </svg>
  )}

  {/* ---------- GTA VI: Roman VI Sunset Vice City con Palmeras ---------- */}
  {game === 'gta6' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="gta-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FF1493" />
          <stop offset="45%" stop-color="#FF007F" />
          <stop offset="100%" stop-color="#00F5FF" />
        </linearGradient>
        <filter id="gta-glow-lg" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#FF007F" flood-opacity="0.7" />
          <feDropShadow dx="0" dy="3" stdDeviation="2" flood-color="#00F5FF" flood-opacity="0.5" />
        </filter>
      </defs>
      <g filter="url(#gta-glow-lg)">
        {/* Silueta sutil de palmera izquierda */}
        <path d="M7 26 C9 18 13 14 15 12 C13 15 12 18 11 26 Z" fill="#00F5FF" opacity="0.35" />
        <path d="M7 19 C12 17 14 15 15 12 C12 18 10 21 8 23 Z" fill="#00F5FF" opacity="0.3" />
        {/* Silueta sutil de palmera derecha */}
        <path d="M41 26 C39 18 35 14 33 12 C35 15 36 18 37 26 Z" fill="#FF1493" opacity="0.35" />
        <path d="M41 19 C36 17 34 15 33 12 C36 18 38 21 40 23 Z" fill="#FF1493" opacity="0.3" />

        {/* Letra 'V' */}
        <path
          d="M8 10 L15.5 10 L20.5 32 L22 32 L27 10 L34.5 10 L25 38 L17 38 Z"
          fill="url(#gta-grad)"
          stroke="#000"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
        {/* Letra 'I' con serifs horizontales clásicos */}
        <path
          d="M32 10 L44 10 L44 14.5 L40 14.5 L40 33.5 L44 33.5 L44 38 L32 38 L32 33.5 L36 33.5 L36 14.5 L32 14.5 Z"
          fill="url(#gta-grad)"
          stroke="#000"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )}

  {/* ---------- FREE FIRE: Emblema Bélico Alado de Fuego (Auténtico FF) ---------- */}
  {game === 'freefire' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ff-flame-core" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#D00000" />
          <stop offset="35%" stop-color="#FF3E00" />
          <stop offset="70%" stop-color="#FF9500" />
          <stop offset="100%" stop-color="#FFEA00" />
        </linearGradient>
        <linearGradient id="ff-wing-left" x1="100%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#990000" />
          <stop offset="60%" stop-color="#FF3E00" />
          <stop offset="100%" stop-color="#FFAA00" />
        </linearGradient>
        <filter id="ff-inferno" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#FF3E00" flood-opacity="0.8" />
          <feDropShadow dx="0" dy="0" stdDeviation="2" flood-color="#FFEA00" flood-opacity="0.6" />
        </filter>
      </defs>
      <g filter="url(#ff-inferno)">
        {/* Ala de fuego izquierda estilizada */}
        <path
          d="M24 38 C17 36 7 28 4 18 C8 19 13 17 16 13 C14 17 12 21 15 25 C18 20 20 16 22 9 C22 16 19 22 23 27 Z"
          fill="url(#ff-wing-left)"
        />
        {/* Ala de fuego derecha estilizada */}
        <path
          d="M24 38 C31 36 41 28 44 18 C40 19 35 17 32 13 C34 17 36 21 33 25 C30 20 28 16 26 9 C26 16 29 22 25 27 Z"
          fill="url(#ff-wing-left)"
        />

        {/* Llama central táctica con cresta Free Fire */}
        <path
          d="M24 4 C27 12 34 17 34 26 C34 35 27 42 24 44 C21 42 14 35 14 26 C14 17 21 12 24 4 Z"
          fill="url(#ff-flame-core)"
          stroke="#450A0A"
          stroke-width="1.2"
        />

        {/* Cuchillo / Daga de combate central en metal blanco y oro */}
        <path d="M24 8 L27 22 L24 36 L21 22 Z" fill="#FFFBEB" />
        <path d="M24 8 L24 36 L21 22 Z" fill="#FED7AA" />

        {/* Monograma bélico FF estilizado */}
        <path d="M21 18 L26 16 L25.5 19 L23 19.5 L22.5 22 L25 21.5 L24.5 24 L21 25 Z" fill="#7F1D1D" />
      </g>
    </svg>
  )}

  {/* ---------- FORTNITE: Emblema Slanted F Battle Royale con Escudo ---------- */}
  {game === 'fortnite' && (
    <svg viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="fn-neon" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00F5FF" />
          <stop offset="50%" stop-color="#00A2FF" />
          <stop offset="100%" stop-color="#8B5CF6" />
        </linearGradient>
        <filter id="fn-glow-lg" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#00F5FF" flood-opacity="0.6" />
        </filter>
      </defs>
      <g filter="url(#fn-glow-lg)">
        {/* Escudo poligonal de fondo */}
        <polygon
          points="24,5 41,11 36,37 24,44 12,37 7,11"
          fill="#0C1322"
          stroke="url(#fn-neon)"
          stroke-width="2"
        />
        {/* Letra 'F' clásica en relieve */}
        <path
          d="M15 12 L33 12 L31 18 L22 18 L21 23 L29 23 L27 29 L20 29 L18 38 L12 38 Z"
          fill="url(#fn-neon)"
          stroke="#000"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </g>
    </svg>
  )}
</div>

<style>
  .game-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.3s ease;
  }

  .game:hover .game-badge {
    transform: scale(1.15) translateY(-3px);
  }
</style>
